With(
    {request: ParseJSON(Self.sampleProperty)},
    If(
        Text(request.kind) = "integration-probe",
        IfError(
            Set(
                varIntegrationResponse,
                JSON(
                    {
                        requestId: Text(request.requestId),
                        service: Text(request.service),
                        ok: Text(request.service) = "canvas",
                        message: If(Text(request.service) = "canvas", "Canvas received the request and returned this response.", "This service has not been configured. No backend operation was performed."),
                        data: {operation: Text(request.operation), echo: Text(request.payload.message)}
                    },
                    JSONFormat.Compact
                )
            ),
            Set(
                varIntegrationResponse,
                JSON({requestId: Text(request.requestId), service: Text(request.service), ok: false, message: FirstError.Message}, JSONFormat.Compact)
            )
        )
    )
)
